<div class="post-card">
  <%- partial('_partial/article', { post: page, index: false }) %>

  <% if (page.prev || page.next) { %>
  <nav class="post-nav">
    <% if (page.prev) { %>
    <a class="prev" href="<%- url_for(page.prev.path) %>" title="<%= page.prev.title %>">← <%= page.prev.title %></a>
    <% } %>
    <% if (page.next) { %>
    <a class="next" href="<%- url_for(page.next.path) %>" title="<%= page.next.title %>"><%= page.next.title %> →</a>
    <% } %>
  </nav>
  <% } %>
</div>
