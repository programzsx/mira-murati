<% if (page.tag) { %>
<!-- Single Tag Page -->
<section class="page-hero reveal">
  <span class="page-hero-label"><%= __('tag') %></span>
  <h1 class="page-hero-title"><span class="accent">#<%= page.tag %></span></h1>
  <p class="page-hero-meta"><%= page.posts.length %> <%= __('posts') %></p>
</section>

<% if (page.posts && page.posts.length > 0) { %>
<div class="posts">
  <% page.posts.each(function(post) { %>
    <%- partial('_partial/article', { post: post, index: true }) %>
  <% }) %>
</div>
<% } else { %>
<p class="empty"><%= __('no_posts') %></p>
<% } %>

<%- partial('_partial/pagination') %>
<% } else { %>
<!-- Tags Index Page -->
<section class="page-hero reveal">
  <span class="page-hero-label"><%= __('tags') %></span>
  <h1 class="page-hero-title"><span class="accent"><%= __('all_tags') %></span></h1>
  <p class="page-hero-meta"><%= site.tags.length %> <%= __('tags') %></p>
</section>

  <%
  // Compute max post count for tag sizing
  var maxCount = 1;
  site.tags.each(function(t) {
    if (t.posts.length > maxCount) maxCount = t.posts.length;
  });
  %>

  <% if (site.tags.length > 0) { %>
  <div class="tag-cloud">
    <% site.tags.each(function(tag) { %>
    <%
      var ratio = tag.posts.length / maxCount;
      var size = ratio < 0.3 ? 's' : (ratio < 0.6 ? 'm' : 'l');
    %>
    <a class="tag-cloud-item tag-<%= size %>" href="<%- url_for(tag.path) %>">
      <%= tag.name %>
      <span class="tag-cloud-count"><%= tag.posts.length %></span>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="empty"><%= __('no_tags') %></p>
  <% } %>
</div>
<% } %>
