<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%
  var title = page.title;
  if (is_archive()) {
    title = __('archive');
    if (is_month()) title += ': ' + page.year + '/' + page.month;
    else if (is_year()) title += ': ' + page.year;
  } else if (is_category()) {
    title = __('category') + ': ' + page.category;
  } else if (is_tag()) {
    title = __('tag') + ': ' + page.tag;
  }
  %>
  <title><%= title ? title + ' — ' + config.title : config.title %></title>
  <%- open_graph() %>
  <% if (theme.rss) { %><%- feed_tag(theme.rss) %><% } %>
  <% if (config.syntax_highlighter) { %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11.9.0/build/styles/github-dark.min.css">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Noto+Serif+SC:wght@600;700;800;900&family=Noto+Sans+SC:wght@400;500;700;900&display=swap" rel="stylesheet">
  <%- css('css/style') %>
  <% if (theme.site_password && theme.site_password.length > 0) { %>
  <meta name="site-password" content="<%= theme.site_password %>">
  <% } %>
</head>
