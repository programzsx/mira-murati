<%
var tocContent = toc(page.content, { max_depth: theme.toc.max_depth || 3 });
var hasToc = tocContent && tocContent.trim().length > 0;
%>

<% if (hasToc) { %>
<aside class="sidebar">
  <details class="sidebar-toc-details">
    <summary class="sidebar-toc-title"><%= __('toc') %></summary>
    <nav class="sidebar-toc" aria-label="<%= __('toc') %>">
      <%- tocContent %>
    </nav>
  </details>
</aside>
<% } %>
