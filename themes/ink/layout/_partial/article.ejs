<article class="post-card">
  <%
  var rawText = post.content.replace(/<[^>]+>/g, '').replace(/\s/g, '');
  var charCount = rawText.length;
  var readingTime = Math.max(1, Math.round(charCount / 400));
  %>

  <header class="entry-header">
    <% if (index) { %>
    <h2 class="entry-title">
      <a href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h2>
    <% } else { %>
    <h1 class="entry-title-detail"><%= post.title %></h1>
    <% } %>
  </header>

  <% if (index) { %>
    <section class="entry-content">
      <%- post.content %>
    </section>
  <% } else { %>
  <% var isProtected = post.password && post.password.length > 0; %>
  <% if (isProtected) { %>
  <meta name="post-password" content="<%= post.password %>">
  <div class="password-gate" id="password-gate">
    <div class="password-gate-inner">
      <div class="password-gate-icon">🔒</div>
      <h3>这篇文章需要密码</h3>
      <p>请输入密码后阅读</p>
      <div class="password-gate-input">
        <input type="password" id="password-input" placeholder="输入密码" autocomplete="off">
        <button id="password-submit">确认</button>
      </div>
      <p id="password-error" class="password-error"></p>
    </div>
  </div>
  <div class="post-body-protected" id="post-body-protected" style="display:none;">
  <section class="entry-content post-body">
    <%- post.content %>
  </section>
  </div>
  <% } else { %>
  <section class="entry-content post-body">
    <%- post.content %>
  </section>
  <% } %>

  <% if (post.tags && post.tags.length > 0) { %>
  <footer class="post-footer">
    <div class="post-tags">
      <% post.tags.forEach(function(tag) { %>
      <a class="tag" href="<%- url_for(tag.path) %>"><%= tag.name %></a>
      <% }) %>
    </div>
  </footer>
  <% } %>
  <% } %>

  <footer class="entry-footer">
    <time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
    <span> · </span>
    <span><%= readingTime %> 分钟阅读</span>
    <% if (config.author) { %>
    <span> · </span>
    <span><%= config.author %></span>
    <% } %>
  </footer>
</article>
