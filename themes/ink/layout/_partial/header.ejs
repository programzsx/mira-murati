<header class="header">
  <nav class="nav">
    <div class="nav-logo">
      <a href="<%= url_for('/') %>"><%= config.title %></a>
    </div>
    <div class="nav-right">
      <% if (theme.menu) { %>
      <ul class="nav-menu">
        <% for (var name in theme.menu) { %>
        <li><a href="<%= url_for(theme.menu[name]) %>"><%= name %></a></li>
        <% } %>
      </ul>
      <% } %>
      <button class="search-btn" id="search-btn" type="button" aria-label="搜索" title="搜索（/）">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <% if (theme.rss) { %>
      <a class="rss-link" href="<%= theme.rss %>" target="_blank" rel="noopener" aria-label="RSS 订阅" title="RSS 订阅">RSS</a>
      <% } %>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换主题" title="切换主题">
        <span class="icon-moon" aria-hidden="true">🌙</span>
        <span class="icon-sun" aria-hidden="true">☀️</span>
      </button>
    </div>
  </nav>
</header>
