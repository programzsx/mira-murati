<header class="header">
  <nav class="nav">
    <div class="nav-logo">
      <a href="<%= url_for('/') %>"><%= config.title %></a>
    </div>
    <div class="nav-right">
      <% if (theme.menu) { %>
      <ul class="nav-menu">
        <% for (var name in theme.menu) { %>
        <li><a href="<%= url_for(theme.menu[name]) %>"><%= name %></a></li>
        <% } %>
      </ul>
      <% } %>
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换主题" title="切换主题">
        <span class="icon-moon" aria-hidden="true">🌙</span>
        <span class="icon-sun" aria-hidden="true">☀️</span>
      </button>
    </div>
  </nav>
</header>
