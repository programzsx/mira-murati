<header class="header">
  <nav class="nav">
    <div class="nav-logo">
      <a href="<%= url_for('/') %>"><%= config.title %></a>
    </div>
    <div class="nav-right">
      <% if (theme.menu) { %>
      <ul class="nav-menu">
        <% for (var name in theme.menu) { %>
        <li><a href="<%= url_for(theme.menu[name]) %>"><%= name %></a></li>
        <% } %>
      </ul>
      <% } %>
      <button class="icon-btn search-btn" id="search-btn" type="button" aria-label="搜索" title="搜索（/）">
        <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><line x1="10.5" y1="10.5" x2="14" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <% if (theme.rss) { %>
      <a class="rss-link" href="<%= theme.rss %>" target="_blank" rel="noopener" aria-label="RSS 订阅" title="RSS 订阅">RSS</a>
      <% } %>
      <button class="icon-btn theme-toggle" id="theme-toggle" type="button" aria-label="切换主题" title="切换主题">
        <span class="icon-moon" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><path d="M13.2 9.6A5.4 5.4 0 0 1 6.4 2.8a.5.5 0 0 0-.6-.6 6.2 6.2 0 1 0 8 8 .5.5 0 0 0-.6-.6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg></span>
        <span class="icon-sun" aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.4"/><g stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><line x1="8" y1="1" x2="8" y2="2.6"/><line x1="8" y1="13.4" x2="8" y2="15"/><line x1="1" y1="8" x2="2.6" y2="8"/><line x1="13.4" y1="8" x2="15" y2="8"/><line x1="3" y1="3" x2="4.1" y2="4.1"/><line x1="11.9" y1="11.9" x2="13" y2="13"/><line x1="13" y1="3" x2="11.9" y2="4.1"/><line x1="4.1" y1="11.9" x2="3" y2="13"/></g></svg></span>
      </button>
    </div>
  </nav>
</header>
