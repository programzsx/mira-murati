<%
// ── Site-wide password gate ──
// When theme.site_password is set, the entire site is wrapped in a
// client-side gate. The cleartext password never reaches the browser —
// we emit only a SHA-256 hash, and the JS recomputes the hash on submit
// to compare. (Still not "real" auth — see comments in _config.yml.)
var sitePassword = (theme.site_password || '').toString();
var hasSiteGate = sitePassword.length > 0;
%><!DOCTYPE html>
<html lang="<%= config.language %>">
<%- partial('_partial/head') %>
<body>
  <div class="reading-progress" id="reading-progress"></div>
  <%
  // 404 page bypasses the password gate so the not-found page is itself reachable
  var isNotFound = (page && page.path === '404.html');
  var effectiveGate = hasSiteGate && !isNotFound;
  %>
  <div class="site" id="post-body-protected" style="<%= effectiveGate ? 'display:none;' : '' %>">
    <%- partial('_partial/header') %>
    <%
    // Only post detail pages have a sidebar (TOC). All other pages
    // (home, category, tag, archive, custom pages) use a single full-width column.
    var hasSidebar = is_post();
    %>
    <div class="content-wrapper <%= hasSidebar ? 'is-detail' : 'is-list' %>">
      <% if (hasSidebar) { %><%- partial('_partial/sidebar') %><% } %>
      <main class="main">
        <%- body %>
      </main>
    </div>
    <%- partial('_partial/footer') %>
  </div>
  <% if (effectiveGate) { %>
  <div class="password-gate password-gate--site" id="password-gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" aria-describedby="gate-desc">
    <div class="password-gate-inner">
      <div class="password-gate-icon" aria-hidden="true">🔒</div>
      <h3 id="gate-title">本站需要密码</h3>
      <p id="gate-desc">请输入密码后继续</p>
      <div class="password-gate-input">
        <label for="password-input" class="u-sr-only">密码</label>
        <input type="password" id="password-input" placeholder="输入密码" autocomplete="off">
        <button id="password-submit" type="button">确认</button>
      </div>
      <p id="password-error" class="password-error" role="alert" aria-live="polite"></p>
    </div>
  </div>
  <% } %>
  <%- js('js/main') %>
</body>
</html>
